{
    "name": "w3chess/w3chess",
    "description": "W3Chess - Mail- and Web-based Chess (idiomatic PHP 8 port)",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "W3Chess\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "W3Chess\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
